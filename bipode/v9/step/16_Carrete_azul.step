#124703 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.E-02),#124700,
  'distance_accuracy_value','confusion accuracy');
#124704 = PRODUCT_RELATED_PRODUCT_CATEGORY('part',$,(#7));
ENDSEC;
